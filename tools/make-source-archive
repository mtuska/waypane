#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
set -euo pipefail

if [[ $# -ne 1 || "$1" != /* ]]; then
    echo "usage: $0 /absolute/output/directory" >&2
    exit 2
fi

waypane_root=$(cd "$(dirname "$0")/.." && pwd)
waypane_output=$1
waypane_version=$(sed -nE 's/^project\(Waypane VERSION ([0-9]+\.[0-9]+\.[0-9]+).*/\1/p' "$waypane_root/CMakeLists.txt")
if [[ -z "$waypane_version" ]]; then
    echo "could not determine Waypane version" >&2
    exit 1
fi

install -d "$waypane_output"
if git -C "$waypane_root" rev-parse --verify HEAD >/dev/null 2>&1; then
    git -C "$waypane_root" archive \
        --format=tar.gz \
        --prefix="waypane-${waypane_version}/" \
        --output="$waypane_output/waypane-${waypane_version}.tar.gz" \
        HEAD
else
    # Allow an initial, not-yet-committed checkout to exercise RPM packaging.
    # Published releases always take the deterministic git-archive path above.
    tar -C "$waypane_root" \
        --sort=name --mtime='UTC 1970-01-01' --owner=0 --group=0 --numeric-owner \
        --exclude='./.git' --exclude='./.vscode' --exclude='./.flatpak-builder' \
        --exclude='./build' --exclude='./build-*' --exclude='./flatpak-build' \
        --exclude='./flatpak-repo' --exclude='./*.flatpak' --exclude='./dist' \
        --exclude='./konsole' --exclude='__pycache__' --exclude='*.pyc' \
        --transform="s,^,waypane-${waypane_version}/," \
        -czf "$waypane_output/waypane-${waypane_version}.tar.gz" .
fi
printf '%s\n' "$waypane_output/waypane-${waypane_version}.tar.gz"
