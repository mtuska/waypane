def data_path() -> Path:
    override = os.environ.get("WAYPANE_DATA_DIR")
    if override:
        return Path(override) / "connections.json"
    config_home = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
    return config_home / "waypane" / "connections.json"


def control_socket_path() -> Path:
    override = os.environ.get("WAYPANE_CONTROL_SOCKET")
    if override:
        return Path(override)
    runtime = os.environ.get("XDG_RUNTIME_DIR")
    if runtime:
        return Path(runtime) / "waypane" / "control.sock"
    return Path(tempfile.gettempdir()) / f"waypane-{os.getuid()}" / "waypane" / "control.sock"


def live_request(method: str, **arguments: Any) -> dict[str, Any]:
    path = control_socket_path()
    request = {"method": method, **arguments}
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
            connection.settimeout(3)
            connection.connect(str(path))
            connection.sendall(json.dumps(request, separators=(",", ":")).encode() + b"\n")
            response = b""
            while not response.endswith(b"\n"):
                chunk = connection.recv(65536)
                if not chunk:
                    break
                response += chunk
    except (OSError, TimeoutError) as error:
        raise ValueError(f"Waypane is not running or its control socket is unavailable: {error}") from error
    if not response:
        raise ValueError("Waypane closed the control connection without a response")
    result = json.loads(response)
    if not result.get("ok"):
        raise ValueError(result.get("error", "Waypane rejected the live operation"))
    return result


def load_document() -> dict[str, Any]:
    path = data_path()
    if not path.exists():
        return {"schemaVersion": 1, "connections": []}
    document = json.loads(path.read_text(encoding="utf-8"))
    if not isinstance(document, dict) or not isinstance(document.get("connections"), list):
        raise ValueError("Waypane profile store has an invalid structure")
    return document


def save_document(document: dict[str, Any]) -> None:
    path = data_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    descriptor, temporary = tempfile.mkstemp(prefix=".connections-", suffix=".json", dir=path.parent)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as stream:
            json.dump(document, stream, indent=2, sort_keys=False)
            stream.write("\n")
            stream.flush()
            os.fsync(stream.fileno())
        os.chmod(temporary, 0o600)
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def redacted(profile: dict[str, Any]) -> dict[str, Any]:
    safe = dict(profile)
    safe.pop("secretId", None)
    return safe


def find_profile(connection_id: str) -> dict[str, Any]:
    for profile in load_document()["connections"]:
        if profile.get("id") == connection_id:
            return profile
    raise ValueError(f"Unknown connection: {connection_id}")


def ssh_argv(profile: dict[str, Any]) -> list[str]:
    result = ["ssh"]
    if profile.get("sshConfigAlias"):
        return ["ssh", profile["sshConfigAlias"]]
    port = int(profile.get("port", 22))
    if port != 22:
        result.extend(["-p", str(port)])
    identity = profile.get("identityFile", "")
    if identity:
        result.extend(["-i", identity])
    jumps = profile.get("jumpHosts", [])
    if jumps:
        result.extend(["-J", ",".join(jumps)])
    for forward in profile.get("localForwards", []):
        result.extend(["-L", forward])
    for forward in profile.get("remoteForwards", []):
        result.extend(["-R", forward])
    for forward in profile.get("dynamicForwards", []):
        result.extend(["-D", forward])
    if profile.get("agentForwarding", False):
        result.append("-A")
    if profile.get("compression", False):
        result.append("-C")
    if profile.get("legacyCompatibility", False):
        result.extend(["-o", "HostKeyAlgorithms=+ssh-rsa"])
        result.extend(["-o", "PubkeyAcceptedAlgorithms=+ssh-rsa"])
        result.extend(["-o", "KexAlgorithms=+diffie-hellman-group1-sha1,diffie-hellman-group14-sha1"])
        result.extend(["-o", "Ciphers=+aes128-cbc,aes192-cbc,aes256-cbc,3des-cbc"])
        result.extend(["-o", "MACs=+hmac-sha1,hmac-sha1-96"])
    if profile.get("hostKeyPolicy") and profile["hostKeyPolicy"] != "ask":
        result.extend(["-o", f"StrictHostKeyChecking={profile['hostKeyPolicy']}"])
    if profile.get("knownHostsFile"):
        result.extend(["-o", f"UserKnownHostsFile={profile['knownHostsFile']}"])
    destination = profile["host"]
    if profile.get("username"):
        destination = f"{profile['username']}@{destination}"
    result.append(destination)
    return result


