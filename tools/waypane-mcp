def text_result(value: Any) -> dict[str, Any]:
    return {"content": [{"type": "text", "text": json.dumps(value, indent=2)}]}


def call_tool(name: str, arguments: dict[str, Any]) -> dict[str, Any]:
    if name == "waypane_list_connections":
        profiles = load_document()["connections"]
        summaries = [
            {
                "id": item.get("id"),
                "name": item.get("name"),
                "host": item.get("host"),
                "port": item.get("port", 22),
                "username": item.get("username", ""),
                "group": item.get("group", ""),
                "folder": item.get("group", ""),
                "tags": item.get("tags", []),
            }
            for item in profiles
        ]
        return text_result(summaries)
    if name == "waypane_get_connection":
        return text_result(redacted(find_profile(arguments["id"])))
    if name == "waypane_search_connections":
        query = str(arguments["query"]).strip().casefold()
        if not query:
            raise ValueError("query is required")
        matches = []
        for item in load_document()["connections"]:
            haystack = " ".join(
                [
                    str(item.get("name", "")),
                    str(item.get("host", "")),
                    str(item.get("username", "")),
                    str(item.get("group", "")),
                    " ".join(item.get("tags", [])),
                ]
            ).casefold()
            if query in haystack:
                matches.append(redacted(item))
        return text_result(matches)
    if name == "waypane_build_ssh_argv":
        return text_result({"argv": ssh_argv(find_profile(arguments["id"]))})
    if name == "waypane_upsert_connection":
        if not str(arguments.get("name", "")).strip() or not str(arguments.get("host", "")).strip():
            raise ValueError("name and host are required")
        port = int(arguments.get("port", 22))
        if port < 1 or port > 65535:
            raise ValueError("port must be between 1 and 65535")
        authentication = arguments.get("authentication", "key" if arguments.get("identityFile") else "agent")
        if authentication not in {"agent", "key", "password"}:
            raise ValueError("unsupported authentication method")
        document = load_document()
        connection_id = arguments.get("id") or str(uuid.uuid4())
        profile = {
            "id": connection_id,
            "name": arguments["name"].strip(),
            "group": arguments.get("folder", arguments.get("group", "")),
            "host": arguments["host"].strip(),
            "port": port,
            "username": arguments.get("username", ""),
            "sshConfigAlias": arguments.get("sshConfigAlias", ""),
            "authentication": authentication,
            "identityFile": arguments.get("identityFile", ""),
            "secretId": "",
            "jumpHosts": arguments.get("jumpHosts", []),
            "tags": arguments.get("tags", []),
            "localForwards": arguments.get("localForwards", []),
            "remoteForwards": arguments.get("remoteForwards", []),
            "dynamicForwards": arguments.get("dynamicForwards", []),
            "remotePath": arguments.get("remotePath", "/"),
            "hostKeyPolicy": arguments.get("hostKeyPolicy", "ask"),
            "knownHostsFile": arguments.get("knownHostsFile", ""),
            "agentForwarding": arguments.get("agentForwarding", False),
            "compression": arguments.get("compression", False),
            "legacyCompatibility": arguments.get("legacyCompatibility", False),
        }
        for index, item in enumerate(document["connections"]):
            if item.get("id") == connection_id:
                profile["secretId"] = item.get("secretId", "")
                document["connections"][index] = profile
                break
        else:
            document["connections"].append(profile)
        save_document(document)
        return text_result(redacted(profile))
    if name == "waypane_delete_connection":
        document = load_document()
        before = len(document["connections"])
        document["connections"] = [item for item in document["connections"] if item.get("id") != arguments["id"]]
        if len(document["connections"]) == before:
            raise ValueError(f"Unknown connection: {arguments['id']}")
        save_document(document)
        return text_result({"deleted": arguments["id"]})
    if name == "waypane_runtime_status":
        return text_result(live_request("status"))
    if name == "waypane_connect_ssh":
        find_profile(arguments["id"])
        return text_result(live_request("connect", id=arguments["id"]))
    if name == "waypane_browse_sftp":
        find_profile(arguments["id"])
        return text_result(live_request("browseFiles", id=arguments["id"]))
    if name == "waypane_open_tunnels":
        profile = find_profile(arguments["id"])
        if not any(profile.get(key, []) for key in ("localForwards", "remoteForwards", "dynamicForwards")):
            raise ValueError("connection has no configured forwards")
        return text_result(live_request("openTunnels", id=arguments["id"]))
    if name == "waypane_open_local_terminal":
        return text_result(live_request("localTerminal"))
    if name == "waypane_split_terminal":
        direction = arguments.get("direction")
        if direction not in {"right", "down"}:
            raise ValueError("direction must be right or down")
        return text_result(live_request("splitTerminal", direction=direction))
    if name == "waypane_edit_remote_file":
        find_profile(arguments["id"])
        path = str(arguments.get("path", "")).strip()
        if not path:
            raise ValueError("path is required")
        return text_result(live_request("editRemoteFile", id=arguments["id"], path=path))
    raise ValueError(f"Unknown tool: {name}")


def response(request_id: Any, result: dict[str, Any]) -> dict[str, Any]:
    return {"jsonrpc": "2.0", "id": request_id, "result": result}


def error_response(request_id: Any, code: int, message: str) -> dict[str, Any]:
    return {"jsonrpc": "2.0", "id": request_id, "error": {"code": code, "message": message}}


def handle(request: dict[str, Any]) -> dict[str, Any] | None:
    request_id = request.get("id")
    method = request.get("method")
    if request_id is None:
        return None
    if method == "initialize":
        return response(
            request_id,
            {
                "protocolVersion": PROTOCOL_VERSION,
                "capabilities": {"tools": {"listChanged": False}},
                "serverInfo": SERVER,
                "instructions": "Manage Waypane profiles. Secret material is never exposed. SSH argv output is not a shell command.",
            },
        )
    if method == "ping":
        return response(request_id, {})
    if method == "tools/list":
        return response(request_id, {"tools": TOOLS})
    if method == "tools/call":
        params = request.get("params", {})
        try:
            return response(request_id, call_tool(params.get("name", ""), params.get("arguments", {})))
        except (KeyError, TypeError, ValueError, json.JSONDecodeError) as error:
            return response(request_id, {"content": [{"type": "text", "text": str(error)}], "isError": True})
    return error_response(request_id, -32601, f"Method not found: {method}")


def main() -> int:
    for line in sys.stdin:
        try:
            request = json.loads(line)
            reply = handle(request)
            if reply is not None:
                print(json.dumps(reply, separators=(",", ":")), flush=True)
        except (json.JSONDecodeError, TypeError) as error:
            print(json.dumps(error_response(None, -32700, f"Parse error: {error}"), separators=(",", ":")), flush=True)
        except Exception as error:  # Keep the protocol process alive; details belong on stderr.
            print(f"waypane-mcp: {error}", file=sys.stderr, flush=True)
            print(json.dumps(error_response(None, -32603, "Internal error"), separators=(",", ":")), flush=True)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
