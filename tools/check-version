"""Verify that every release-facing Waypane version agrees with CMake."""

from __future__ import annotations

import re
import sys
from pathlib import Path


ROOT = Path(__file__).resolve().parent.parent


def match(path: str, pattern: str) -> str:
    text = (ROOT / path).read_text(encoding="utf-8")
    found = re.search(pattern, text, re.MULTILINE)
    if not found:
        raise SystemExit(f"could not find version in {path}")
    return found.group(1)


cmake = match("CMakeLists.txt", r"project\(Waypane VERSION ([0-9]+\.[0-9]+\.[0-9]+)")
versions = {
    "CMakeLists.txt": cmake,
    "MCP server": match(
        "tools/waypane-mcp",
        r'SERVER = \{"name": "waypane", "version": "([^"]+)"\}',
    ),
    "AppStream metadata": match(
        "packaging/dev.tuska.waypane.metainfo.xml",
        r'<release version="([^"]+)"',
    ),
    "RPM spec": match("packaging/rpm/waypane.spec", r"^Version:\s*([^\s]+)"),
}

expected = sys.argv[1].removeprefix("v").split("-", 1)[0] if len(sys.argv) == 2 else cmake
failed = False
for source, version in versions.items():
    if version != expected:
        print(f"{source}: {version} (expected {expected})", file=sys.stderr)
        failed = True

if failed:
    raise SystemExit(1)
print(f"Waypane version {expected} is consistent")
